%layout 'admin';
%title 'SReview volunteer overview';
<h1>SReview volunteer overview</h1>
% if (my $message = flash 'msg') {
<p class="alert alert-warning"><%= $message %></p>
% }
<table class="table table-hover">
  <tr><th>Talk</th><th>State</th><% if($can_skip) { %><th></th><% } %></tr>
  % foreach my $talk(@$talks) {
  <tr><td><a href='/r/<%= $talk->[0] %>'><%= $talk->[1] %></a></td><td><%= $talk->[3] %></td>
  % if($can_skip) {
    <td>
    % if($talk->[3] eq 'preview') {
      <form method="post" action="/volunteer/skip/<%= $talk->[2] %>"><button type="submit" class="btn btn-sm btn-outline-secondary">I don't want to review this talk</button></form>
    % }
    </td>
  % }
  </tr>
  % }
</table>
